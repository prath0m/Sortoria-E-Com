# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
LOG_LEVEL=INFO

# --- Data stores ---
DATABASE_URL=postgres:///sartoria
TEST_DATABASE_NAME=sartoria_test
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Run Celery tasks inline (no worker needed). Handy for quick local runs.
CELERY_TASK_ALWAYS_EAGER=false

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SECURE=false

# --- Email (console backend in dev; SMTP in prod) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Sartoria <hello@sartoria.test>

# --- Razorpay (test mode keys from dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Seed accounts ---
SEED_ADMIN_PASSWORD=Sartoria@Admin1
SEED_MANAGER_PASSWORD=Sartoria@Manager1
SEED_CUSTOMER_PASSWORD=Sartoria@Guest1

# Public origin of the API, used for absolute links in emails/invoices
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Production only ---
# Where uploads are stored (serve this directory at /media/ from nginx).
MEDIA_ROOT=
# Leave on behind an HTTPS proxy that sets X-Forwarded-Proto.
SECURE_SSL_REDIRECT=true
